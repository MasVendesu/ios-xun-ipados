+
+static void
+line(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), 0);
+	wr(GPIO_CFG(pin), CFG_PULL_UP | (high ? 0 : CFG_OUTPUT));
+}
+
+static bool
+level_of(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+i2c_start(struct bus *b)
+{
+	line(b->sda, true);
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, false);
+	half_bit();
+}
+
+static void
+i2c_stop(struct bus *b)
+{
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, true);
+	half_bit();
+}
+
+static bool
+i2c_bit(struct bus *b, bool out)
+{
+	bool in;
+
+	line(b->sda, out);
+	half_bit();
+	line(b->scl, true);
+	for (unsigned stretched = 0; !level_of(b->scl) && stretched < 100; stretched++) {
+		half_bit();
+	}
+	half_bit();
+	in = level_of(b->sda);
+	line(b->scl, false);
+	return in;
+}
+
+static bool
+i2c_write(struct bus *b, uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit(b, (byte >> bit) & 1);
+	}
+	return !i2c_bit(b, true);
+}
+
+static uint8_t
+i2c_read(struct bus *b, bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(b, true));
+	}
+	i2c_bit(b, !more);
+	return byte;
+}
