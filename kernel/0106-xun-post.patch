+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				address = entry[i].address;
+				break;
+			}
+		}
+	}
+	if (address == 0) {
+		printf("rpmh: no \"%s\" in the command database\n", name);
+		return false;
+	}
+	if (mode == 0xffffffffu) {              /* (hakios_rpmh_write: one raw value at +0) */
+		offsets[n] = 0; values[n++] = mv;
+		goto send;
+	}
+	if (mv != 0) {
+		offsets[n] = 0; values[n++] = mv;
+	}
+	if (mode != 0) {
+		offsets[n] = 8; values[n++] = mode;
+	}
+	offsets[n] = 4; values[n++] = enable;
+send:
+	lck_mtx_lock(&rpmh_lock);
+	need(&rsc);
+	if (rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS) == 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		printf("rpmh: TCS %u busy: %s not set\n", RPMH_TCS, name);
+		return false;
+	}
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	for (unsigned c = 0; c < n; c++) {
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(c), MSGID_WRITE_WAITED);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(c) + 4, address + offsets[c]);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(c) + 8, values[c]);
+	}
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_WAIT_FOR_DONE, (1u << n) - 1);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, (1u << n) - 1);
+	settle();
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~TCS_TRIGGER);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_ACTIVE_MODE);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_TRIGGER);
+	began = now_us();
+	while (now_us() - began < 100000) {
+		done = rd(rsc.base + RSC_IRQ_STATUS) & (1u << RPMH_TCS);
+		if (done) {
+			break;
+		}
+		sleep_us(50);
+	}
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, 0);
+	lck_mtx_unlock(&rpmh_lock);
+	printf("rpmh: %s (%#x): %u mV, %s, mode %u: %s\n", name, address, mv, enable ? "on" : "off", mode,
+	    done ? "done" : "NOT DONE");
+	return done != 0;
+}
+
+bool
+hakios_rpmh_write(const char *name, uint32_t value)
+{
+	return hakios_rpmh_regulator(name, value, false, 0xffffffffu);
+}
