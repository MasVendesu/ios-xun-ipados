+		printf("mpss: glink: THE MODEM'S QUEUE (item %u) IS NOT THERE after %u ms (at %#x, %u bytes)\n", ITEM_GLINK_THEIR_QUEUE,
+		    (uint32_t)((now_us() - began) / 1000), g->theirs, g->theirs_size);
+		return false;
+	}
+	printf("mpss: glink: the modem's queue (%u) at %#lx, %u bytes, after %llu ms; marks: ours read to %#x written to %#x, "
+	    "the modem's read to %#x written to %#x\n", ITEM_GLINK_THEIR_QUEUE, SMEM_PHYS + g->theirs, g->theirs_size,
+	    (now_us() - began) / 1000, smem_word(g->descriptor + GLINK_OUR_TAIL), smem_word(g->descriptor + GLINK_OUR_HEAD),
+	    smem_word(g->descriptor + GLINK_THEIR_TAIL), smem_word(g->descriptor + GLINK_THEIR_HEAD));
+	/* Linux: "Reset the tx pipe's head and the rx pipe's tail" -- ours; the other two are the modem's */
+	smem_poke(g->descriptor + GLINK_OUR_HEAD, 0);
+	smem_poke(g->descriptor + GLINK_THEIR_TAIL, 0);
+	settle();
 	return true;
 }
+
+static int
+mpss_qrtr_out(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	int error = qrtr_send_on(&glink_mpss, type, from_port, to_node, to_port, data, length);
+
+	mpss_qrtr.out += error == 0;
+	return error;
+}
+
+static void
+mpss_qrtr_hello(uint32_t to_node)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int error = mpss_qrtr_out(QRTR_HELLO, QRTR_CONTROL, to_node, QRTR_CONTROL, &hello, sizeof(hello));
+
+	mpss_qrtr.hello_sent = mpss_qrtr.hello_sent || error == 0;
+	printf("mpss: qrtr: our HELLO to node %#x: %s (%d)\n", to_node, error == 0 ? "SENT" : "NOT SENT", error);
+}
+
+static void
+mpss_qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	struct qrtr_control control = { 0 };
+	uint32_t at;
+
+	if (!qrtr_parse("mpss", data, length, &header, &at)) {
+		return;
+	}
+	mpss_qrtr.in++;
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		mpss_qrtr_out(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (!(header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP ||
+	    header.type == QRTR_DEL_CLIENT || header.type == QRTR_DEL_LOOKUP)) {
+		if (mpss_qrtr.said++ < 16) {
+			printf("mpss: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n",
+			    header.size, header.from_node, header.from_port, header.to_port);
+		}
+		return;
+	}
+	memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+	switch (control.command) {
+	case QRTR_HELLO:
+		printf("mpss: qrtr: HELLO FROM NODE %u (port %#x)\n", header.from_node, header.from_port);
+		/* answered once (the audio DSP's is too): the modem's name server answers a hello with its services */
+		if (mpss_qrtr.hellos++ == 0) {
+			mpss_qrtr_hello(header.from_node);
+		}
+		break;
+	case QRTR_NEW_SERVER:
+		mpss_qrtr.services++;
+		printf("mpss: qrtr: modem service %u (%#x) instance %u (version %u, instance %u) at node %u port %u\n", control.words[0],
+		    control.words[0], control.words[1], control.words[1] & 0xff, control.words[1] >> 8, control.words[2],
+		    control.words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+		printf("mpss: qrtr: modem service %u instance %u at node %u port %u has gone\n", control.words[0], control.words[1],
+		    control.words[2], control.words[3]);
+		break;
+	case QRTR_NEW_LOOKUP:
+		if (mpss_qrtr.lookups++ < 32) {
+			printf("mpss: qrtr: the modem looks for service %u (%#x), instance %u: nobody here offers it\n", control.words[0],
+			    control.words[0], control.words[1]);
+		}
+		break;
+	case QRTR_DEL_CLIENT:
+		printf("mpss: qrtr: the modem's client at node %u port %u has gone\n", control.words[0], control.words[1]);
+		break;
+	case QRTR_BYE:
+		printf("mpss: qrtr: BYE from node %u\n", header.from_node);
+		break;
+	default:
+		break;
+	}
+}
+
+/* the modem's link: every millisecond its rings heard, its queue pumped, what came on IPCRTR acted on */
+static void
+mpss_link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct glink_edge *g = &glink_mpss;
+	struct glink_packet *packet;
+	uint64_t began = now_us(), opened_at = 0, looked = 0;
+	uint32_t smp2p_at = 0, size = 0;
+	bool fatal = false;
+
+	while (mpss_link_runs) {
+		sleep_us(1000);
+		doorbells();
+		/* its "slave-kernel", every tenth of a second: a modem that gives up says so here, and why */
+		if (!fatal && now_us() - looked >= 100000) {
+			struct smp2p words;
+			int e;
+
+			looked = now_us();
+			if (smp2p_at == 0) {
+				smp2p_at = mpss_item(ITEM_SMP2P_MPSS, &size);
+			}
+			if (smp2p_at != 0 && smem_peek(smp2p_at, &words, sizeof(words)) && words.magic == SMP2P_MAGIC &&
+			    (e = smp2p_entry(&words, "slave-kernel")) >= 0 && (words.entry[e].value & DSP_FATAL)) {
+				uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+				char reason[160] = { 0 };
+
+				fatal = true;
+				if (cat != 0) {
+					(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+				}
+				printf("mpss: link: THE MODEM SAYS IT HAS GIVEN UP (\"slave-kernel\" = %#x): %s\n", words.entry[e].value,
+				    reason[0] ? reason : "(no reason)");
+			}
+		}
+		lck_mtx_lock(g->lock);
+		glink_pump(g);
+		{
+			struct glink_channel *channel = &g->channel[CHANNEL_QRTR];
+
+			/*
+			 * The modem opens IPCRTR itself, as the audio DSP does; if it has not two seconds after the versions
+			 * are agreed, it is opened from our side (Linux's qcom_glink_create_local(): the modem acknowledges
+			 * and opens its end, which glink_pump() answers as any open)
+			 */
+			if (g->agreed && !channel->asked && channel->theirs == 0 && now_us() - began > 2000000ull) {
+				char name[8] = "IPCRTR";
+
+				printf("mpss: glink: the modem has not opened \"IPCRTR\": opened from our side as channel %u\n", channel->ours);
+				glink_say(g, GLINK_OPEN, channel->ours, (uint32_t)strlen(name) + 1, name, sizeof(name));
+				channel->asked = true;
+			}
+			if (channel->open && opened_at == 0) {
+				opened_at = now_us();
+			}
+			packet = channel->first;
+			channel->first = channel->last = NULL;
+		}
+		lck_mtx_unlock(g->lock);
+		while (packet != NULL) {
+			struct glink_packet *next = packet->next;
+
+			mpss_qrtr_input(packet->data, packet->length);
+			kfree_data(packet, sizeof(*packet) + packet->length);
+			packet = next;
+		}
+		/* no hello from the modem a second after the channel opened: ours, to everyone (Linux's name server's say_hello()) */
+		if (opened_at != 0 && !mpss_qrtr.hello_sent && mpss_qrtr.hellos == 0 && now_us() - opened_at > 1000000ull) {
+			mpss_qrtr_hello(QRTR_NODE_BCAST);
+			if (!mpss_qrtr.hello_sent) {
+				opened_at = now_us();           /* (again in a second) */
+			}
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+/* after READY: the edge, our version, the link's thread; then what came of it, said */
+static void
+mpss_link(void)
+{
+	struct glink_edge *g = &glink_mpss;
+	thread_t thread;
+	uint64_t began;
+	uint32_t listen_s = 10;
+
+	if (!mpss_glink_items()) {
+		printf("mpss: link: NO GLINK WITH THE MODEM (its items)\n");
+		return;
+	}
+	lck_mtx_lock(g->lock);
+	g->features = GLINK_INTENT_REUSE;
+	g->agreed = g->broken = false;
+	g->said = g->heard = 0;
+	bzero(g->others, sizeof(g->others));
+	g->trace = 60;
+	g->up = true;
+	bzero(&mpss_qrtr, sizeof(mpss_qrtr));
+	began = now_us();
+	glink_say(g, GLINK_VERSION, GLINK_VERSION_1, g->features, NULL, 0);
+	lck_mtx_unlock(g->lock);
+	mpss_link_runs = true;
+	if (kernel_thread_start(mpss_link_thread, NULL, &thread) != KERN_SUCCESS) {
+		mpss_link_runs = false;
+		printf("mpss: link: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !g->channel[CHANNEL_QRTR].open && !g->broken; ms++) {
+		sleep_ms(1);
+	}
+	printf("mpss: link: %llu ms after our version: versions %s (features %#x); \"IPCRTR\" is %s; the modem also opened \"%s\" "
+	    "\"%s\" \"%s\" \"%s\"\n", (now_us() - began) / 1000, g->agreed ? "agreed" : "NOT AGREED", g->features,
+	    g->channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN", g->others[0], g->others[1], g->others[2], g->others[3]);
+	PE_parse_boot_argn("dadampss_listen", &listen_s, sizeof(listen_s));
+	sleep_ms(listen_s * 1000);
+	printf("mpss: link: after %u s more: %s; the modem told of %u services and looked for %u; GLINK said %u and heard %u "
+	    "messages, QRTR sent %u and received %u datagrams; its doorbells heard: %u\n", listen_s,
+	    mpss_qrtr.hellos ? "HELLO FROM THE MODEM" : (mpss_qrtr.hello_sent ? "OUR HELLO SENT, NONE FROM THE MODEM" :
+	    "NO HELLO EITHER WAY"), mpss_qrtr.services, mpss_qrtr.lookups, g->said, g->heard, mpss_qrtr.out, mpss_qrtr.in,
+	    mpss_rings);
+	/* (the link stays up: its thread runs on, and services the modem tells of later are said as they come) */
+}
+
+
+static void
+mpss_thread_body(void);
+
+static void
+mpss_thread(void *arg __unused, wait_result_t w __unused)
+{
+	mpss_thread_body();
+	if (hakios_mpss_state == 0) {
+		hakios_mpss_state = -1;
+	}
+}
+
+static void
+mpss_thread_body(void)
+{
+	uint32_t wait_s = 50, assign = 1, last = ~0u, at = 0, size = 0, wait_ready = 60, cx_level = 384;
+	uint64_t began;
+
+	PE_parse_boot_argn("dadampss_delay", &wait_s, sizeof(wait_s));
+	PE_parse_boot_argn("dadampss_assign", &assign, sizeof(assign));
+	sleep_ms(wait_s * 1000);
+	printf("mpss: the modem: booting it\n");
+	if (mpss_item(ITEM_SMP2P_MPSS, &size) != 0) {
+		printf("mpss: its SMP2P item is already there: it ran before this kernel; not started again\n");
+		return;
+	}
+	if (assign) {
+		(void)mpss_assign(0x84a00000ull, 0x4900000ull);
+		(void)mpss_assign(0x89300000ull, 0xa80000ull);
+	}
+	{
+		/* its path to DDR (Android's rproc_ddr / crypto_ddr icc votes): MC0, SH0, ACV, as the Wi-Fi's (dadampss_icc=N) */
+		uint32_t icc = 0x1000, bw, on = 1u << 30 | 1u << 29 | 1u << 14 | 1u;
+
+		PE_parse_boot_argn("dadampss_icc", &icc, sizeof(icc));
+		if (icc != 0) {
+			bw = 1u << 30 | 1u << 29 | (icc & 0x3fff) << 14 | (icc & 0x3fff);
+			printf("mpss: path to memory: MC0 %s, SH0 %s, ACV %s\n", hakios_rpmh_write("MC0", bw) ? "voted" : "NOT VOTED",
+			    hakios_rpmh_write("SH0", bw) ? "voted" : "NOT VOTED", hakios_rpmh_write("ACV", on) ? "on" : "NOT ON");
+		}
+	}
+	PE_parse_boot_argn("dadampss_cx", &cx_level, sizeof(cx_level));
+	printf("mpss: CX at %u %s, MSS %s\n", cx_level, hakios_rpmh_level("cx.lvl", cx_level) ? "voted" : "NOT VOTED",
+	    hakios_rpmh_level("mss.lvl", 320) ? "voted" : "NOT VOTED");
+	{
+		/*
+		 * The rails and clocks the Wi-Fi's link_up() votes (RF S-rails s5f/s3g/s7i, the BB rail s4d, L3F/L2F, RF_CLK1 and
+		 * LN_BB_CLK): the modem came up every time they were voted before it (the Wi-Fi thread at ~40 s, w130m/w132m/w142m)
+		 * and never once the Wi-Fi waited for the modem instead (w140m..w144m). dadampss_rails=0: not.
+		 */
+		static const struct { const char *name; uint32_t mv, mode; } rails[] = {
+			{ "ldof3", 1800, 7 }, { "ldof2", 1200, 7 }, { "smpd4", 876, 0 }, { "smpf5", 876, 0 }, { "smpg3", 1860, 0 },
+			{ "smpi7", 1312, 0 }, { "clka1", 0, 0 }, { "clka3", 0, 0 },
+		};
+		uint32_t on = 1;
+
+		PE_parse_boot_argn("dadampss_rails", &on, sizeof(on));
+		for (unsigned i = 0; on && i < sizeof(rails) / sizeof(rails[0]); i++) {
+			if (!hakios_rpmh_regulator(rails[i].name, rails[i].mv, true, rails[i].mode)) {
+				printf("mpss: %s NOT VOTED\n", rails[i].name);
+			}
+		}
+	}
+	printf("mpss: AOP: %s\n", mailbox_send("{class: image, res: load_state, name: modem, val: on}") ? "told" : "NOT TOLD");
+	(void)mpss_our_item();
+	if ((!option("dadampss_nodtb") && !mpss_image("modem_dtb", MPSS_DTB_PAS, MPSS_DTB_MEM, MPSS_DTB_MEM_SIZE) &&
+	    !option("dadampss_dtbany")) ||
+	    !mpss_image("modem", MPSS_PAS, MPSS_MEM, MPSS_MEM_SIZE)) {
+		printf("mpss: THE MODEM WAS NOT STARTED\n");
+		return;
+	}
+	began = now_us();
+	PE_parse_boot_argn("dadampss_wait", &wait_ready, sizeof(wait_ready));
+	while (now_us() - began < (uint64_t)wait_ready * 1000000ull) {
+		struct smp2p words;
+		uint32_t state = 0;
+
+		if (at == 0) {
+			at = mpss_item(ITEM_SMP2P_MPSS, &size);
+		}
+		if (at != 0 && smem_peek(at, &words, sizeof(words)) && words.magic == SMP2P_MAGIC) {
+			int e = smp2p_entry(&words, "slave-kernel");
+
+			state = e < 0 ? 0 : words.entry[e].value;
+		}
+		{
+			static uint32_t last_ring = ~0u;
+			uint32_t ring;
+
+			need(&ipcc);
+			ring = rd(ipcc.base + IPCC_RECEIVED);
+			if (ring != last_ring) {
+				printf("mpss: after %llu ms: IPCC's next doorbell for us: %#x (client %u, signal %u)\n", (now_us() - began) / 1000,
+				    ring, ring >> 16, ring & 0xffff);
+				last_ring = ring;
+			}
+		}
+		if (state != last) {
+			printf("mpss: after %llu ms: its SMP2P item %s, state %#x%s%s%s\n", (now_us() - began) / 1000, at ? "there" : "not there",
+			    state, (state & 2) ? " READY" : "", (state & 4) ? " HANDOVER" : "", (state & 1) ? " FATAL" : "");
+			last = state;
+		}
+		if (state & 1) {
+			uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+			char reason[160] = { 0 };
+
+			if (cat != 0) {
+				(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+			}
+			printf("mpss: THE MODEM FAILED: %s\n", reason[0] ? reason : "(no reason)");
+			return;
+		}
+		if (state & 2) {
+			uint32_t link = 1;
+
+			printf("mpss: THE MODEM IS UP\n");
+			hakios_mpss_state = 1;
+			PE_parse_boot_argn("dadampss_link", &link, sizeof(link));
+			if (link) {
+				mpss_link();
+			}
+			return;
+		}
+		sleep_ms(20);
+	}
+	printf("mpss: no READY from the modem in %u s\n", wait_ready);
+	{
+		static struct smem_item found[256];
+		uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &psize);
+		unsigned count = partition ? smem_items(partition, cacheline, found, 256) : 0;
+		char line[400];
+		int n = 0;
+
+		for (unsigned i = 0; i < count && i < 256 && n < (int)sizeof(line) - 16; i++) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)", found[i].item, found[i].size);
+		}
+		printf("mpss: the partition for us and the modem: at %#x, %#x bytes, %u items:%s\n", partition, psize, count, line);
+	}
+	{
+		uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+		char reason[200] = { 0 };
+
+		if (cat != 0) {
+			(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+		}
+		printf("mpss: crash reason (item 421): %s\n", cat ? (reason[0] ? reason : "(empty)") : "(no item)");
+	}
+}
+
+void
+redwood_adsp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("adsp_step", &last_step, sizeof(last_step));
+	if (last_step == 0 && (!PE_parse_boot_argn("adsp", &on, sizeof(on)) || on != 1)) {
+		return;
+	}
+	if (option("dadaadsp")) {
+		dada = true;
+		smem_phys = 0x81d00000UL;
+		cmd_db_phys = 0x81c60000UL;
+		adsp_memory = 0x9ee00000u;
+		adsp_memory_size = 0x04580000u;
+		ipcc.phys = 0x00406000;
+		rsc.phys = 0x16520000;
+		glink.channel[CHANNEL_APR].name = "adsp_apps";     /* GPR, AudioReach's */
+		printf("adsp: the Xiaomi 15's (dada) audio DSP: its addresses and its companion image (dadaadsp=1)\n");
+	} else if (pe_arm_get_soc_base_phys() != REDWOOD_SOC_BASE) {
+		printf("adsp: adsp=1 and adsp_step=N are for the phone's audio DSP, and this is not the phone\n");
+		return;
+	}
+	if (last_step == 0) {
+		/* all of it, on a thread of its own, and left up (on dada not step 11: SM8750's audio services are
+		 * GPR's, not APR's, and the battery manager needs only the link) */
+		last_step = STEPS;
+		keep = true;
+		quiet = !dada;           /* (dada: every step said, while it is new) */
+		pause_ms = 0;
+		listen_seconds = 1;
+		new_from = STEPS + 1;
+		if (kernel_thread_start(whole_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("adsp: no thread: the audio DSP is not brought up\n");
+			return;
+		}
+		thread_deallocate(thread);
+		if (dada && option("dadampss") && kernel_thread_start(mpss_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+		tell("adsp: the audio DSP is being brought up beside the system's start (adsp=1)\n");
+		return;
+	}
+	if (last_step > STEPS) {
+		last_step = STEPS;
+	}
+	keep = option("adsp_keep");
+	new_from = last_step;
+	PE_parse_boot_argn("adsp_new", &new_from, sizeof(new_from));
+	PE_parse_boot_argn("adsp_pause", &pause_ms, sizeof(pause_ms));
+	printf("adsp: steps up to %u; those from %u on are new and wait %u ms after each announcement\n", last_step, new_from,
+	    pause_ms);
+	run_steps();
+	if (option("adsp_return")) {
+		printf("adsp: back to the loader (adsp_return)\n");
+		loader_return();
+	}
+	printf("adsp: the system goes on starting\n");
+}
