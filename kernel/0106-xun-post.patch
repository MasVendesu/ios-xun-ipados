+	printf("adreno: gpu: THE 3D CORE IS RECOVERED (%u time%s in this run); submissions up to %u are given up as done\n",
+	    gpu_recoveries, gpu_recoveries == 1 ? "" : "s", gpu_fence);
+	return true;
