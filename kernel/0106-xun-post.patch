+/* ---- the test tone ----------------------------------------------------------------------------------- */
+
+/* 1 kHz at 48 kHz, -20 dBFS (a peak of 3277): one cycle */
+static const int16_t tone[48] = {
+	0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249,
+	3277, 3249, 3165, 3028, 2838, 2600, 2317, 1995, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1995, -2317, -2600, -2838, -3028, -3165, -3249,
+	-3277, -3249, -3165, -3028, -2838, -2600, -2317, -1995, -1638, -1254, -848, -428,
+};
+static uint32_t tone_at;
+
+static void
+period_fill(unsigned period, bool silent)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+
+	for (unsigned frame = 0; frame < PERIOD_FRAMES; frame++) {
+		int16_t sample = silent ? 0 : tone[tone_at++ % 48];
+
+		samples[2 * frame] = sample;
+		samples[2 * frame + 1] = sample;
+	}
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));        /* the DSP reads memory, not our caches */
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+period_write(unsigned period)
+{
+	uint32_t write[8] = { (uint32_t)(buffer_address + 4096 * period), (uint32_t)((buffer_address + 4096 * period) >> 32),
+		              map_handle, PERIOD_BYTES, period, 0, 0, 0 };
+
+	return redwood_adsp_apr(APR_SVC_ASM, STREAM_PORT, WRITE_TOKEN | period, ASM_DATA_CMD_WRITE_V2, write, sizeof(write), 0, NULL);
+}
+
+/*
+ * The tone, written period after period as the DSP gives them back, for `ms'; then silence until
+ * the DSP has given every period back. What came back and how fast is said.
+ */
+static bool
+play(uint32_t ms, bool amplifiers)
+{
+	uint64_t began, last_look, ended;
+	uint32_t sent = 0, done_before = written_done, healthy_looks = 0;
+	bool ok = true, tone_over = false;
+
+	returned = 0;
+	tone_at = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill(p, false);
+	}
+	began = last_look = now_us();
+	for (unsigned p = 0; p < PERIODS; p++) {
+		if (!period_write(p)) {
+			say("sound: the write of period %u could not be sent\n", p);
+			return false;
+		}
+		sent++;
+	}
+	for (;;) {
+		uint32_t back = returned;
+		uint64_t now = now_us();
+
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (!(back & 1u << p) || tone_over) {
+					continue;
+				}
+				period_fill(p, false);
+				if (!period_write(p)) {
+					say("sound: the write of period %u could not be sent\n", p);
+					ok = false;
+					tone_over = true;
+					break;
+				}
+				sent++;
+			}
+		}
+		if (!tone_over && (now - began >= ms * 1000ull || stopping)) {
+			tone_over = true;
+		}
+		if (tone_over && written_done - done_before >= sent) {
+			break;
+		}
+		if (now - began > ms * 1000ull + 2000000) {
+			say("sound: THE DSP HAS NOT GIVEN EVERY PERIOD BACK 2 s after the end (%u of %u)\n", written_done - done_before,
+			    sent);
+			ok = false;
+			break;
+		}
+		if (written_done == done_before && now - began > 1000000) {
+			say("sound: THE DSP HAS GIVEN NO PERIOD BACK IN A SECOND\n");
+			ok = false;
+			break;
+		}
+		if (amplifiers && now - last_look >= 200000) {
+			last_look = now;
+			healthy_looks++;
+			if (!redwood_speaker_healthy()) {
+				ok = false;
+				tone_over = true;
+			}
+		}
+		sleep_ms(2);
+	}
+	ended = now_us();
+	{
+		uint32_t done = written_done - done_before;
+		uint64_t frames = (uint64_t)done * PERIOD_FRAMES, us = ended - began;
+
+		say("sound: %u periods written, %u given back (%u with an error), %u underflows, in %llu ms: the DSP took %llu frames a "
+		    "second%s\n", sent, done, write_errors, underflows, us / 1000, us ? frames * 1000000 / us : 0,
+		    amplifiers ? "" : " (the amplifiers off: nothing to hear)");
+		if (amplifiers) {
+			say("sound: the amplifiers' status looked at %u times while it played\n", healthy_looks);
+		}
+	}
+	return ok;
+}
+
+/* ---- sound=4: what iOS plays ------------------------------------------------------------------------------ */
+
+/*
+ * /dev/redwood-audio's writer (the audio server's real-time thread, redwood_audio.c) puts frames
+ * into a ring and does not wait; the feeder, a thread of ours, takes them from there into each
+ * period the DSP gives back (and silence when there is nothing), so the stream never stops
+ * while the run lasts. The amplifiers are only on while there is sound: the watcher starts them
+ * (and fades them in to sound_below) when a write is not silence, and stops them after three
+ * seconds of silence or no writes.
+ */
+#define RING_FRAMES             32768           /* 0.68 s; a power of two, the indices run on and wrap */
+#define SILENCE                 8               /* samples no larger than this are silence (as redwood_audio.c's) */
+#define QUIET_BEFORE_OFF_US     3000000ull
+
+static int16_t ring[RING_FRAMES * 2];
+static volatile uint32_t ring_head, ring_tail;  /* frames: written by the sink, taken by the feeder */
+static volatile uint64_t last_sound_us;         /* when the latest write that was not silence came */
+static volatile bool feeder_runs, watcher_runs;
+static uint64_t fed_frames, silent_frames, ios_frames;
+static volatile uint32_t ios_peak;              /* the largest sample since the amplifiers last started */
+
+/* From the writer's thread, under redwood_audio.c's lock: never waits. */
+static uint32_t
+ios_sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t head = ring_head, room = RING_FRAMES - (head - ring_tail), taken = count < room ? count : room;
+	bool sound = false;
+
+	for (uint32_t i = 0; i < taken; i++) {
+		int16_t left = frames[2 * i], right = frames[2 * i + 1];
+		uint32_t l = left < 0 ? (uint32_t)-(int32_t)left : (uint32_t)left, r = right < 0 ? (uint32_t)-(int32_t)right : (uint32_t)right;
+
+		ring[2 * ((head + i) % RING_FRAMES)] = left;
+		ring[2 * ((head + i) % RING_FRAMES) + 1] = right;
+		sound |= l > SILENCE || r > SILENCE;
+		if (l > ios_peak || r > ios_peak) {
+			ios_peak = l > r ? l : r;
+		}
+	}
+	OSMemoryBarrier();
+	ring_head = head + taken;
+	ios_frames += taken;
+	if (sound) {
+		last_sound_us = now_us();
+	}
+	return taken;
+}
+
+static uint32_t guard_periods;                  /* periods through the guard */
+static volatile bool guard_on;                  /* the amplifiers are on: what the guard lets through is heard */
+
+/* tenths of a dB as text: "-5.7" */
+static const char *
+db_text(char *text, int tenths)
+{
+	snprintf(text, 16, "%s%d.%d", tenths < 0 ? "-" : "", (tenths < 0 ? -tenths : tenths) / 10, (tenths < 0 ? -tenths : tenths) % 10);
+	return text;
+}
+
+/* What the guard has done since it was last said (redwood_guard.c), as one line; nothing if `quiet'. */
+static void
+guard_say(const char *when, bool quiet)
+{
+	struct redwood_guard_report r;
+	char t[6][16];
+
+	redwood_guard_take_report(&r);
+	if (r.blocks == 0 || quiet) {
+		return;
+	}
+	/* (levels at the speakers: dB under a full-scale square wave at Android's level; gains in dB) */
+	say("sound: the guard%s: peaks in %u, out %u (of 32768); gain now %s dB, least %s dB, held down by the 0.2 s/3 s/60 s "
+	    "averages in %u/%u/%u of %u periods; peaks limited in %u frames (by %s dB at most); averages %s/%s/%s dB\n",
+	    when, r.peak_in, r.peak_out, db_text(t[0], redwood_guard_decibels(r.gain * r.gain >> 30)),
+	    db_text(t[1], redwood_guard_decibels(r.least_gain * r.least_gain >> 30)), r.rms_blocks, r.fast_blocks, r.slow_blocks,
+	    r.blocks, r.limited_frames, db_text(t[2], redwood_guard_decibels((uint64_t)r.least_peak_gain * r.least_peak_gain >> 2)),
+	    db_text(t[3], redwood_guard_decibels(r.rms)), db_text(t[4], redwood_guard_decibels(r.fast)),
+	    db_text(t[5], redwood_guard_decibels(r.slow)));
+}
+
+/* A period from the ring, the rest of it silence. */
+static void
+period_fill_ios(unsigned period)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+	uint32_t tail = ring_tail, available = ring_head - tail, n = available < PERIOD_FRAMES ? available : PERIOD_FRAMES;
+
+	OSMemoryBarrier();
+	for (uint32_t i = 0; i < n; i++) {
+		samples[2 * i] = ring[2 * ((tail + i) % RING_FRAMES)];
+		samples[2 * i + 1] = ring[2 * ((tail + i) % RING_FRAMES) + 1];
+	}
+	bzero(samples + 2 * n, (PERIOD_FRAMES - n) * 4);
+	OSMemoryBarrier();
+	ring_tail = tail + n;
+	fed_frames += n;
+	silent_frames += PERIOD_FRAMES - n;
+	/* the guard, on every period, silence too: its filter and its averages go on (redwood_guard.c) */
+	redwood_guard_process(samples, PERIOD_FRAMES);
+	if (n != 0 && redwood_audio_recording_fed()) {
+		redwood_audio_record_fed(samples, n);
+	}
+	guard_periods++;
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static void
+feeder_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t sent = 0, failed = 0;
+
+	returned = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill_ios(p);
+		sent += period_write(p);
+	}
+	while (!stopping) {
+		uint32_t back = returned;
+		static bool was_on;
+
+		if (guard_on && !was_on) {
+			guard_say("", true);    /* (what it did to the silence meanwhile is of no interest) */
+			guard_periods = 0;
+		} else if (was_on && !guard_on) {
+			guard_say(" until the amplifiers stopped", false);
+		} else if (guard_on && guard_periods >= 250) {
+			guard_say(", 5 s", false);
+			guard_periods = 0;
+		}
+		was_on = guard_on;
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (back & 1u << p) {
+					period_fill_ios(p);
+					if (period_write(p)) {
+						sent++;
+					} else {
+						failed++;
+					}
+				}
+			}
+		}
+		sleep_ms(2);
+	}
+	say("sound: the feeder stops: %u periods written (%u could not be sent), %u given back (%u with an error), %u underflows; "
+	    "from iOS %llu frames came, %llu went to the DSP, %llu of silence filled in\n", sent, failed, written_done, write_errors,
+	    underflows, ios_frames, fed_frames, silent_frames);
+	feeder_runs = false;
+	thread_terminate(current_thread());
+}
+
+/* The amplifiers' level as the guard is to reckon with it (sound_guard_as: louder than it is, for a test). */
+static void
+guard_level(uint32_t level_below)
+{
+	redwood_guard_attenuation(level_below < guard_as ? level_below : guard_as);
+}
+
+/*
+ * The amplifiers are off. The guard goes on at their level all the same: what it lets through now reaches them
+ * 160 ms later, behind the periods queued at the DSP, and if that is sound, they will have been started by then
+ * (70 ms after it comes). While they are off nothing but silence comes, and the averages fall as a speaker cools.
+ * Only when nothing can be heard at all -- iOS's volume at 0, the amplifiers given up on -- is the guard told so.
+ */
+static void
+guard_off(bool unheard)
+{
+	guard_on = false;
+	if (unheard) {
+		redwood_guard_attenuation(REDWOOD_GUARD_SILENT);
+	}
+}
+
+/*
+ * The amplifiers on while there is sound, at the volume iOS has set (redwood_audio_volume(): how
+ * far under the loudest, sound_below under Android's level), and off while iOS's volume is 0;
+ * their status looked at every 200 ms while they are on. On the sound's thread.
+ */
+static void
+watch(void)
+{
+	bool on = false, given_up = false, muted = false;
+	uint64_t last_look = 0, last_monitor = 0;
+	uint32_t starts = 0, changes = 0, generation = 0, extra = 0, monitor = 0, monitor_looks = 0;
+
+	guard_level(below);                     /* (from the first sample on: see guard_off()) */
+
+	while (!stopping) {
+		uint64_t now = now_us(), sounded = last_sound_us;
+		uint32_t extra_now, generation_now;
+		bool muted_now;
+
+		if (redwood_audio_volume(&extra_now, &muted_now, &generation_now) && generation_now != generation) {
+			generation = generation_now;
+			extra = extra_now;
+			muted = muted_now;
+			changes++;
+			say("sound: iOS sets the volume: %s%u.%03u dB under the loudest, which is %u.%03u dB under Android's level%s\n",
+			    muted ? "muted (0), " : "", extra / 8, extra % 8 * 125, below / 8, below % 8 * 125,
+			    on ? (muted ? ": the amplifiers are stopped" : ": the amplifiers follow") : "");
+			if (muted) {
+				guard_off(true);
+				if (on) {
+					redwood_speaker_stop();
+					on = false;
+				}
+			} else if (on && !redwood_speaker_volume(below + extra, 1)) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (!given_up) {
+				guard_level(below + extra);
+			}
+		}
+		if (!on && !given_up && !muted && sounded != 0 && now - sounded < 100000) {
+			say_when("iOS plays: the amplifiers are started");
+			starts++;
+			ios_peak = 0;
+			if (!redwood_speaker_start() || !redwood_speaker_volume(below + extra, 1)) {
+				say("sound: THE AMPLIFIERS DID NOT START; iOS's sound goes on to the DSP, unheard\n");
+				guard_off(true);
+				given_up = true;
+			} else {
+				on = true;
+				guard_on = true;
+				last_look = now_us();
+				last_monitor = 0;
+				monitor_looks = 0;
+				/* (what is written now is heard after the periods already queued at the DSP: PERIODS x 20 ms) */
+				say("sound: the amplifiers are up %llu ms after the first write that was not silence; that write reaches "
+				    "them %u ms after it was made, behind the periods queued at the DSP\n", (last_look - sounded) / 1000,
+				    PERIODS * PERIOD_FRAMES / 48);
+			}
+		} else if (on && now - sounded > QUIET_BEFORE_OFF_US) {
+			say_when("three seconds of silence: the amplifiers are stopped");
+			say("sound: what iOS wrote while they were on peaked at %u%% of full scale (%u)\n", ios_peak * 100 / 32768,
+			    ios_peak);
+			guard_off(false);
+			redwood_speaker_stop();
+			on = false;
+		} else if (on && now - last_look >= 200000) {
+			last_look = now;
+			if (!redwood_speaker_healthy()) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (now - last_monitor >= 1000000) {
+				/* the amplifiers' temperature and the battery as they see it, every second: a reduction if Android's table asks for one */
+				uint32_t wanted;
+
+				last_monitor = now;
+				wanted = redwood_speaker_monitor(monitor_looks++ % 10 == 0);
+				if (wanted != monitor) {
+					say("sound: the amplifiers' watch asks for %u.%03u dB less (it was %u.%03u)\n", wanted / 8, wanted % 8 * 125,
+					    monitor / 8, monitor % 8 * 125);
+					monitor = wanted;
+					redwood_guard_monitor(monitor);
+				}
+			}
+		}
+		sleep_ms(5);
+	}
+	guard_off(true);
+	say("sound: the watcher stops; the amplifiers were started %u times, iOS set the volume %u times%s\n", starts, changes,
+	    given_up ? ", and the amplifiers were then given up on" : "");
+	watcher_runs = false;
+}
+
+/* ---- the whole ---------------------------------------------------------------------------------------- */
+
+static bool running, taken_down;
+
+static void
+take_down(void)
+{
+	stopping = true;
+	if (level >= 4) {
+		redwood_audio_set_sink("nothing", NULL);
+	}
+	for (unsigned ms = 0; ms < 3000 && (feeder_runs || watcher_runs); ms++) {
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&sound_lock);
+	if (running && !taken_down) {
+		taken_down = true;
+		redwood_speaker_stop();
+		stream_off();
+		afe_off();
+		pins_off();
+		lck_mtx_lock(&redwood_smmu_lock);
+		shared_put(0);
+		lck_mtx_unlock(&redwood_smmu_lock);
+		redwood_adsp_apr_events(NULL);
+		say("sound: everything of the sound's is stopped and put back\n");
+	}
+	lck_mtx_unlock(&sound_lock);
+}
+
+static void
+sound_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	const uint8_t *acf = NULL;
+	uint64_t acf_size = 0;
+	uint32_t changes, ones, sync_changes, sync_ones;
+	bool ok = false;
+
+	lck_mtx_lock(&sound_lock);
+	if (taken_down) {
+		lck_mtx_unlock(&sound_lock);
+		thread_terminate(current_thread());
+	}
+	if (level == 4) {
+		say("sound: level 4: what iOS plays, through the port, a stream and the amplifiers, until the run ends\n");
+	} else {
+		say("sound: level %u: %s, for %u s\n", level, level == 1 ? "the speakers' TDM port" : level == 2 ?
+		    "the port and a stream with a test tone, the amplifiers off" :
+		    "the port, a stream with a test tone, and the amplifiers", seconds);
+	}
+	if (level >= 3) {
+		acf = redwood_adsp_fw_file("aw882xx_acf.bin", &acf_size);
+		if (acf == NULL) {
+			say("sound: no /fw/aw882xx_acf.bin: put the phone's /vendor/etc/aw882xx_acf.bin into fw-audio/ and run SYSTEM=1 "
+			    "userland/build.sh\n");
+			goto out;
+		}
+	}
+	if (level >= 2) {
+		lck_mtx_lock(&redwood_smmu_lock);
+		ok = shared_get(0);
+		lck_mtx_unlock(&redwood_smmu_lock);
+		if (!ok) {
+			goto out;
+		}
+		ok = false;
+		redwood_adsp_apr_events(events);
+	}
+	announce("the TDM pins (GPIO 97 to 100) to the interface, as Android's active state has them");
+	pins_on();
+	if (!afe_on()) {
+		goto out;
+	}
+	sleep_ms(20);
+	pin_activity(97, "the bit clock (gpio97)", &changes, &ones);
+	pin_activity(100, "the frame sync (gpio100)", &sync_changes, &sync_ones);
+	say("sound: %s\n", changes > 100 && sync_changes > 4 ? "THE TDM CLOCK AND FRAME SYNC RUN at the pins" :
+	    "THE PINS DO NOT SHOW A RUNNING TDM CLOCK");
+	if (level == 1) {
+		sleep_ms(seconds * 1000);
+		ok = true;
+		goto out;
+	}
+	if (!stream_on()) {
+		goto out;
+	}
+	if (level == 4) {
+		thread_t feeder;
+
+		announce("the amplifiers, set up from Android's Music profile, powered down until iOS plays");
+		if (!redwood_speaker_prepare(acf, acf_size)) {
+			goto out;
+		}
+		redwood_adsp_fw_free(acf, acf_size);
+		acf = NULL;
+		feeder_runs = true;
+		if (kernel_thread_start(feeder_thread, NULL, &feeder) != KERN_SUCCESS) {
+			feeder_runs = false;
+			say("sound: no thread for the feeder\n");
+			goto out;
+		}
+		thread_deallocate(feeder);
+		watcher_runs = true;
+		redwood_audio_set_sink("the speakers (the audio DSP, redwood_sound.c)", ios_sink);
+		say("sound: WHAT IOS PLAYS GOES TO THE SPEAKERS from here on, %u.%03u dB under Android's level, until the run ends\n",
+		    below / 8, below % 8 * 125);
+		say("sound: through the guard (redwood_guard.c): %u.%03u dB of gain first (sound_gain), then high-pass at 200 Hz; peaks "
+		    "3 dB, the 0.2 s/3 s/60 s power 6/9/12 dB under full scale at Android's level\n", gain / 8, gain % 8 * 125);
+		if (guard_as < below) {
+			say("sound: sound_guard_as=%u: FOR A TEST the guard reckons the amplifiers %u.%03u dB under Android's level, louder "
+			    "than they are, and holds back as much as it would there\n", guard_as, guard_as / 8, guard_as % 8 * 125);
+		}
+		lck_mtx_unlock(&sound_lock);
+		watch();
+		thread_terminate(current_thread());
+	}
+	if (level >= 3) {
+		/* the clock runs (the port is started, the stream as well): the amplifiers can lock to it */
+		announce("the amplifiers, set up from Android's Music profile, then started at the lowest volume");
+		if (!redwood_speaker_prepare(acf, acf_size) || !redwood_speaker_start()) {
+			goto out;
+		}
+	}
+	/* (the amplifiers are faded in before the tone begins: they fade in on silence, and the tone starts at that level) */
+	if (level >= 3 && !redwood_speaker_volume(below, 50)) {
+		goto out;
+	}
+	if (level >= 3) {
+		say("sound: THE TONE PLAYS NOW for %u s: 1 kHz at -20 dBFS, both speakers, %u.%03u dB under Android's level\n",
+		    seconds, below / 8, below % 8 * 125);
+	}
+	say_when("the tone begins");
+	ok = play(seconds * 1000, level >= 3);
+	say_when("the tone has ended");
+	space_faults();
+out:
+	if (acf != NULL) {
+		redwood_adsp_fw_free(acf, acf_size);
+	}
+	lck_mtx_unlock(&sound_lock);
+	take_down();
+	say("sound: %s; last: %s\n", ok ? "LEVEL DONE" : "STOPPED SHORT", last_write);
+	thread_terminate(current_thread());
+}
+
+void
+redwood_sound_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sound", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	if (level > 4) {
+		level = 4;
+	}
+	PE_parse_boot_argn("sound_secs", &seconds, sizeof(seconds));
+	PE_parse_boot_argn("sound_below", &below, sizeof(below));
+	PE_parse_boot_argn("sound_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("sound_guard_as", &guard_as, sizeof(guard_as));
+	PE_parse_boot_argn("sound_gain", &gain, sizeof(gain));
+	if (gain > REDWOOD_GUARD_MAX_GAIN) {
+		gain = REDWOOD_GUARD_MAX_GAIN;
+	}
+	redwood_guard_configure(true, gain);
+	if (level >= 2 && level <= 3 && seconds > 3) {
+		seconds = 3;            /* the test tone: three seconds at most */
+	}
+	running = true;
+	if (kernel_thread_start(sound_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		say("sound: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+redwood_sound_dsp_down(void)
+{
+	if (running) {
+		take_down();
+	}
+}
+
+void
+redwood_sound_quiesce(void)
+{
+	redwood_speaker_quiesce();
 }
diff --git a/bsd/dev/redwood_ufs.c b/bsd/dev/redwood_ufs.c
--- a/bsd/dev/redwood_ufs.c
+++ b/bsd/dev/redwood_ufs.c
@@ -145,6 +145,7 @@
 static volatile struct loader_block *ufs_page;
 static uint8_t *ufs_buffer;             /* the loader's data buffer: filled by it for a read, here for a write */
 static uint32_t ufs_buffer_size, ufs_parts, ufs_seq;
+static volatile bool ufs_closing;      /* the run is ending: nothing more is asked of the loader */
 static uint32_t ufs_bsize[BLOCK_MAX_PARTS];   /* the block size each device is counted in (spec_open sets 512) */
 static int ufs_bmajor = -1, ufs_cmajor = -1;
 static bool ufs_ready, ufs_dead;
@@ -304,7 +305,7 @@
 	uint32_t seq = ++ufs_seq;
 	int64_t status;
 
-	if (ufs_dead) {
+	if (ufs_dead || ufs_closing) {
 		return EIO;
 	}
 	if (op == BLOCK_OP_READ) {
@@ -1617,3 +1618,25 @@
 		}
 	}
 }
+
+/*
+ * The run is ending (loader_return, before the other processors are stopped): nothing more is asked
+ * of the loader, and a request it has not answered yet is waited for (2 s at most), so that the loader
+ * is never in the middle of a read of the storage while this kernel takes the processors and the
+ * interrupt controller away -- which, with the system volume read from the storage (DSU=2), it was.
+ */
+void
+redwood_ufs_close(void)
+{
+	uint64_t deadline;
+
+	if (ufs_page == NULL) {
+		return;
+	}
+	ufs_closing = true;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+	while (ufs_page->answer.answered != ufs_page->ask.request && mach_absolute_time() < deadline) {
+		__builtin_arm_yield();
+	}
+}
diff --git a/bsd/dev/redwood_virtio_blk.c b/bsd/dev/redwood_virtio_blk.c
--- a/bsd/dev/redwood_virtio_blk.c
+++ b/bsd/dev/redwood_virtio_blk.c
@@ -1,19 +1,531 @@
 /*
- * redwood_virtio_blk.c - Stub for physical hardware targets (sapphire)
+ * A virtio block device, so that a disk image on the host can be a block device in the
+ * guest (/dev/rvblk0).  Only with boot-arg virtio_blk=1: the bus address is QEMU's and
+ * means nothing on the phone.
+ *
+ * This exists for the APFS driver.  The volume in ios165/rootfs.dmg is 5.6 GB, which is
+ * too much to hold in guest memory as a RAM disk the way this port's own images are held, and the
+ * point of reading APFS is to read a real image rather than one cut down to fit.  QEMU
+ * serves it straight off the host's disk:
+ *
+ *   -drive file=rootfs.apfs,format=raw,if=none,id=d,readonly=on
+ *   -device virtio-blk-device,drive=d
+ *
+ * Under QEMU's "virt" machine the transport is virtio-mmio and must be the current one,
+ * not "legacy" (-global virtio-mmio.force-legacy=false).
+ *
+ * No interrupt is used and only one request is outstanding at a time: a request is put on
+ * the queue, the device is notified, and the used ring is watched until it comes back.
+ * That is slow in principle and entirely adequate here -- reads come from the APFS
+ * driver's own block cache misses, and the host is serving them out of its page cache.
+ *
+ * Read only.  A write request is refused: nothing in this port has any business writing
+ * to the image, and refusing is one less way to damage it by accident.
  */
-#include <sys/types.h>
-#include <stdbool.h>
+
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
 #include <sys/redwood_virtio_blk.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>  /* xnu-12377: KMA_*/kmem_alloc moved to the internal header */
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+
+#define VIRTIO_BUS              0x0a000000UL    /* QEMU virt: 32 transports of 0x200 bytes */
+#define VIRTIO_SLOTS            32
+#define VIRTIO_SLOT_SIZE        0x200
+
+#define VIRTIO_MAGIC            0x000           /* "virt" */
+#define VIRTIO_VERSION          0x004
+#define VIRTIO_DEVICE_ID        0x008
+#define VIRTIO_DRIVER_FEATURES  0x020
+#define VIRTIO_DRIVER_FEATURES_SEL 0x024
+#define VIRTIO_QUEUE_SEL        0x030
+#define VIRTIO_QUEUE_NUM_MAX    0x034
+#define VIRTIO_QUEUE_NUM        0x038
+#define VIRTIO_QUEUE_READY      0x044
+#define VIRTIO_QUEUE_NOTIFY     0x050
+#define VIRTIO_INTERRUPT_ACK    0x064
+#define VIRTIO_STATUS           0x070
+#define VIRTIO_QUEUE_DESC       0x080
+#define VIRTIO_QUEUE_DRIVER     0x090
+#define VIRTIO_QUEUE_DEVICE     0x0a0
+#define VIRTIO_CONFIG           0x100           /* the device's own configuration */
+
+#define VIRTIO_ID_BLOCK         2
+#define STATUS_ACKNOWLEDGE      1
+#define STATUS_DRIVER           2
+#define STATUS_DRIVER_OK        4
+#define STATUS_FEATURES_OK      8
 
+#define QUEUE_SIZE              64
+#define DESC_F_NEXT             1
+#define DESC_F_WRITE            2
+#define AVAIL_F_NO_INTERRUPT    1
+
+/* the request types we use */
+#define VIRTIO_BLK_T_IN         0
+#define VIRTIO_BLK_S_OK         0
+
+#define VIRTIO_BLK_SECTOR       512             /* virtio-blk counts in these, always */
+
+/*
+ * The most one request may carry.  A request needs one descriptor for its header, one for
+ * its status byte and one per page of the data, so this bounds the chain well inside the
+ * queue.
+ */
+#define BLK_MAX_XFER            (64 * 1024)
+#define BLK_MAX_DATA_DESC       (BLK_MAX_XFER / PAGE_SIZE + 1)
+
+struct vq_desc {
+	uint64_t addr;
+	uint32_t len;
+	uint16_t flags;
+	uint16_t next;
+};
+struct vq_avail {
+	uint16_t flags;
+	uint16_t idx;
+	uint16_t ring[QUEUE_SIZE];
+};
+struct vq_used {
+	uint16_t flags;
+	uint16_t idx;
+	struct {
+		uint32_t id;
+		uint32_t len;
+	} ring[QUEUE_SIZE];
+};
+struct blk_req_hdr {
+	uint32_t type;
+	uint32_t reserved;
+	uint64_t sector;
+};
+
+/* the ring and the small request pieces share one page */
+#define OFFSET_DESC             0x0000
+#define OFFSET_AVAIL            0x0400
+#define OFFSET_USED             0x0800
+#define OFFSET_HDR              0x0c00
+#define OFFSET_STATUS           0x0c40
+
+struct blk_device {
+	vm_offset_t          regs;
+	vm_offset_t          page;
+	uint64_t             page_phys;
+	struct vq_desc      *desc;
+	struct vq_avail     *avail;
+	struct vq_used      *used;
+	struct blk_req_hdr  *hdr;
+	volatile uint8_t    *status;
+	uint16_t             seen;      /* how far the used ring has been read */
+	uint64_t             capacity;  /* in 512-byte sectors */
+	lck_mtx_t            lock;
+};
+
+static LCK_GRP_DECLARE(blk_lck_grp, "redwood-virtio-blk");
+static struct blk_device blk_dev;
+static bool blk_ready;
+static int blk_bmajor = -1, blk_cmajor = -1;
+
+/* One of this driver's devices: every request is a trip through the hypervisor */
 bool
 redwood_virtio_blk_dev(dev_t dev)
 {
+	return (blk_bmajor >= 0 && major(dev) == blk_bmajor) ||
+	       (blk_cmajor >= 0 && major(dev) == blk_cmajor);
+}
+
+static inline uint32_t
+reg_read(struct blk_device *d, uint32_t reg)
+{
+	return *(volatile uint32_t *)(d->regs + reg);
+}
+
+static inline void
+reg_write(struct blk_device *d, uint32_t reg, uint32_t value)
+{
+	*(volatile uint32_t *)(d->regs + reg) = value;
+}
+
+static inline void
+reg_write64(struct blk_device *d, uint32_t reg, uint64_t value)
+{
+	reg_write(d, reg, (uint32_t)value);
+	reg_write(d, reg + 4, (uint32_t)(value >> 32));
+}
+
+/*
+ * One read.  `data` is kernel memory that need not be page aligned and whose pages need
+ * not be next to each other in physical memory, so it goes on the queue a page at a time.
+ */
+static int
+blk_read(struct blk_device *d, uint64_t offset, void *data, size_t len)
+{
+	vm_offset_t va = (vm_offset_t)data;
+	uint16_t idx = 0;
+	size_t done = 0;
+	uint64_t deadline;
+	int error = 0;
+
+	if (len == 0 || len > BLK_MAX_XFER) {
+		return EINVAL;
+	}
+	if ((offset % VIRTIO_BLK_SECTOR) != 0) {
+		return EINVAL;
+	}
+	if (offset / VIRTIO_BLK_SECTOR >= d->capacity ||
+	    (offset + len) / VIRTIO_BLK_SECTOR > d->capacity) {
+		return EINVAL;
+	}
+
+	lck_mtx_lock(&d->lock);
+
+	d->hdr->type = VIRTIO_BLK_T_IN;
+	d->hdr->reserved = 0;
+	d->hdr->sector = offset / VIRTIO_BLK_SECTOR;
+	*d->status = 0xff;
+
+	/* descriptor 0: the header, which the device reads */
+	d->desc[0].addr = d->page_phys + OFFSET_HDR;
+	d->desc[0].len = sizeof(struct blk_req_hdr);
+	d->desc[0].flags = DESC_F_NEXT;
+	d->desc[0].next = 1;
+	idx = 1;
+
+	/* then the data, one descriptor per run of bytes inside a page */
+	while (done < len) {
+		vm_offset_t at = va + done;
+		size_t chunk = PAGE_SIZE - (at & PAGE_MASK);
+
+		if (chunk > len - done) {
+			chunk = len - done;
+		}
+		if (idx >= 1 + BLK_MAX_DATA_DESC) {
+			lck_mtx_unlock(&d->lock);
+			return EINVAL;
+		}
+		d->desc[idx].addr = kvtophys(at);
+		d->desc[idx].len = (uint32_t)chunk;
+		d->desc[idx].flags = DESC_F_WRITE | DESC_F_NEXT;
+		d->desc[idx].next = (uint16_t)(idx + 1);
+		idx++;
+		done += chunk;
+	}
+
+	/* last: the status byte, which the device writes */
+	d->desc[idx].addr = d->page_phys + OFFSET_STATUS;
+	d->desc[idx].len = 1;
+	d->desc[idx].flags = DESC_F_WRITE;
+	d->desc[idx].next = 0;
+
+	d->avail->flags = AVAIL_F_NO_INTERRUPT;
+	d->avail->ring[d->avail->idx % QUEUE_SIZE] = 0;         /* the chain starts at 0 */
+	__builtin_arm_dmb(0xb);
+	d->avail->idx++;
+	__builtin_arm_dmb(0xb);
+	reg_write(d, VIRTIO_QUEUE_NOTIFY, 0);
+
+	/* wait for it to come back; a read off the host's disk should take microseconds */
+	clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
+	for (;;) {
+		__builtin_arm_dmb(0xb);
+		if (d->used->idx != d->seen) {
+			d->seen = d->used->idx;
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("virtio-blk: a read of %lu bytes at %llu went unanswered\n",
+			    (unsigned long)len, offset);
+			lck_mtx_unlock(&d->lock);
+			return EIO;
+		}
+		delay(10);
+	}
+	reg_write(d, VIRTIO_INTERRUPT_ACK, reg_read(d, 0x060));  /* keep the device quiet */
+
+	if (*d->status != VIRTIO_BLK_S_OK) {
+		printf("virtio-blk: a read of %lu bytes at %llu failed with status %u\n",
+		    (unsigned long)len, offset, *d->status);
+		error = EIO;
+	}
+	lck_mtx_unlock(&d->lock);
+	return error;
+}
+
+/* ---- the block device ---- */
+
+static int
+blk_dev_open(__unused dev_t dev, int flags, __unused int devtype, __unused proc_t p)
+{
+	if (!blk_ready) {
+		return ENXIO;
+	}
+	if (flags & FWRITE) {
+		return EROFS;
+	}
+	return 0;
+}
+
+static int
+blk_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused proc_t p)
+{
+	return 0;
+}
+
+static void
+blk_dev_strategy(buf_t bp)
+{
+	struct blk_device *d = &blk_dev;
+	uint64_t offset;
+	size_t len;
+	int error;
+
+	if (!blk_ready) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+	if (!(buf_flags(bp) & B_READ)) {
+		buf_seterror(bp, EROFS);         /* this device never writes */
+		buf_biodone(bp);
+		return;
+	}
+	offset = (uint64_t)buf_blkno(bp) * VIRTIO_BLK_SECTOR;
+	len = buf_count(bp);
+
+	/* trim a request that runs off the end, and refuse one that starts past it */
+	if (offset >= d->capacity * VIRTIO_BLK_SECTOR) {
+		buf_seterror(bp, offset == d->capacity * VIRTIO_BLK_SECTOR ? 0 : EINVAL);
+		buf_setresid(bp, buf_count(bp));
+		buf_biodone(bp);
+		return;
+	}
+	if (offset + len > d->capacity * VIRTIO_BLK_SECTOR) {
+		len = (size_t)(d->capacity * VIRTIO_BLK_SECTOR - offset);
+	}
+
+	error = 0;
+	{
+		uint8_t *dst = (uint8_t *)buf_dataptr(bp);
+		size_t done = 0;
+
+		while (done < len && error == 0) {
+			size_t chunk = len - done;
+
+			if (chunk > BLK_MAX_XFER) {
+				chunk = BLK_MAX_XFER;
+			}
+			error = blk_read(d, offset + done, dst + done, chunk);
+			done += chunk;
+		}
+		buf_setresid(bp, (uint32_t)(buf_count(bp) - (error ? 0 : done)));
+	}
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+blk_dev_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int fflag,
+    __unused proc_t p)
+{
+	struct blk_device *d = &blk_dev;
+
+	if (!blk_ready) {
+		return ENXIO;
+	}
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = VIRTIO_BLK_SECTOR;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		/*
+		 * spec_open() sets the block size to 512 to count the device in 512-byte
+		 * blocks and then sets it back, and treats a refusal of either as the device
+		 * being broken (ENXIO).  virtio-blk counts in 512-byte sectors and nothing
+		 * else, so that is the only size to agree to.
+		 */
+		if (*(uint32_t *)data != VIRTIO_BLK_SECTOR) {
+			return EINVAL;
+		}
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = d->capacity;
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*(uint64_t *)data = BLK_MAX_XFER / VIRTIO_BLK_SECTOR;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+blk_dev_size(dev_t dev)
+{
 	(void)dev;
-	return false;
+	return blk_ready ? VIRTIO_BLK_SECTOR : -1;
+}
+
+static int
+blk_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	/* the character device is here so that tools can see the disk; reads go by buffer */
+	return physio(blk_dev_strategy, NULL, dev, B_READ, (u_int (*)(buf_t))blk_dev_size,
+	    uio, VIRTIO_BLK_SECTOR);
+}
+
+static const struct bdevsw blk_bdevsw = {
+	.d_open     = blk_dev_open,
+	.d_close    = blk_dev_close,
+	.d_strategy = blk_dev_strategy,
+	.d_ioctl    = blk_dev_ioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = blk_dev_size,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw blk_cdevsw = {
+	.d_open       = blk_dev_open,
+	.d_close      = blk_dev_close,
+	.d_read       = blk_dev_read,
+	.d_write      = eno_rdwrt,
+	.d_ioctl      = blk_dev_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+/* ---- bringing it up ---- */
+
+static bool
+blk_attach(struct blk_device *d, int slot)
+{
+	uint32_t cap_lo, cap_hi;
+
+	if (kmem_alloc(kernel_map, &d->page, PAGE_SIZE,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	d->page_phys = kvtophys(d->page);
+	d->desc = (struct vq_desc *)(d->page + OFFSET_DESC);
+	d->avail = (struct vq_avail *)(d->page + OFFSET_AVAIL);
+	d->used = (struct vq_used *)(d->page + OFFSET_USED);
+	d->hdr = (struct blk_req_hdr *)(d->page + OFFSET_HDR);
+	d->status = (volatile uint8_t *)(d->page + OFFSET_STATUS);
+
+	reg_write(d, VIRTIO_STATUS, 0);         /* reset */
+	reg_write(d, VIRTIO_STATUS, STATUS_ACKNOWLEDGE);
+	reg_write(d, VIRTIO_STATUS, STATUS_ACKNOWLEDGE | STATUS_DRIVER);
+	/* nothing in the low half is wanted; bit 32 is VIRTIO_F_VERSION_1 */
+	reg_write(d, VIRTIO_DRIVER_FEATURES_SEL, 0);
+	reg_write(d, VIRTIO_DRIVER_FEATURES, 0);
+	reg_write(d, VIRTIO_DRIVER_FEATURES_SEL, 1);
+	reg_write(d, VIRTIO_DRIVER_FEATURES, 1);
+	reg_write(d, VIRTIO_STATUS, STATUS_ACKNOWLEDGE | STATUS_DRIVER | STATUS_FEATURES_OK);
+	if (!(reg_read(d, VIRTIO_STATUS) & STATUS_FEATURES_OK)) {
+		printf("virtio-blk: slot %d: features refused\n", slot);
+		return false;
+	}
+
+	cap_lo = reg_read(d, VIRTIO_CONFIG);
+	cap_hi = reg_read(d, VIRTIO_CONFIG + 4);
+	d->capacity = ((uint64_t)cap_hi << 32) | cap_lo;
+	if (d->capacity == 0) {
+		printf("virtio-blk: slot %d: the disk is empty\n", slot);
+		return false;
+	}
+
+	reg_write(d, VIRTIO_QUEUE_SEL, 0);
+	if (reg_read(d, VIRTIO_QUEUE_NUM_MAX) < QUEUE_SIZE) {
+		printf("virtio-blk: slot %d: request queue of %u\n", slot,
+		    reg_read(d, VIRTIO_QUEUE_NUM_MAX));
+		return false;
+	}
+	reg_write(d, VIRTIO_QUEUE_NUM, QUEUE_SIZE);
+	reg_write64(d, VIRTIO_QUEUE_DESC, d->page_phys + OFFSET_DESC);
+	reg_write64(d, VIRTIO_QUEUE_DRIVER, d->page_phys + OFFSET_AVAIL);
+	reg_write64(d, VIRTIO_QUEUE_DEVICE, d->page_phys + OFFSET_USED);
+	__builtin_arm_dmb(0xb);
+	reg_write(d, VIRTIO_QUEUE_READY, 1);
+	reg_write(d, VIRTIO_STATUS,
+	    STATUS_ACKNOWLEDGE | STATUS_DRIVER | STATUS_FEATURES_OK | STATUS_DRIVER_OK);
+	return true;
 }
 
 void
 redwood_virtio_blk_init(void)
 {
-	/* Unused on physical hardware (sapphire) */
+	uint32_t enabled = 0;
+	vm_offset_t bus;
+	struct blk_device *d = &blk_dev;
+	int slot;
+
+	if (!PE_parse_boot_argn("virtio_blk", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	bus = ml_io_map(VIRTIO_BUS, VIRTIO_SLOTS * VIRTIO_SLOT_SIZE);
+	for (slot = 0; slot < VIRTIO_SLOTS; slot++) {
+		d->regs = bus + (vm_offset_t)slot * VIRTIO_SLOT_SIZE;
+		if (reg_read(d, VIRTIO_MAGIC) != 0x74726976 ||
+		    reg_read(d, VIRTIO_DEVICE_ID) != VIRTIO_ID_BLOCK) {
+			continue;
+		}
+		if (reg_read(d, VIRTIO_VERSION) != 2) {
+			printf("virtio-blk: slot %d is a legacy transport; start QEMU with "
+			    "-global virtio-mmio.force-legacy=false\n", slot);
+			continue;
+		}
+		lck_mtx_init(&d->lock, &blk_lck_grp, LCK_ATTR_NULL);
+		if (!blk_attach(d, slot)) {
+			lck_mtx_destroy(&d->lock, &blk_lck_grp);
+			continue;
+		}
+		blk_bmajor = bdevsw_add(-1, &blk_bdevsw);
+		if (blk_bmajor < 0) {
+			printf("virtio-blk: bdevsw_add failed\n");
+			return;
+		}
+		blk_cmajor = cdevsw_add_with_bdev(-1, &blk_cdevsw, blk_bmajor);
+		if (blk_cmajor < 0) {
+			printf("virtio-blk: cdevsw_add failed\n");
+			return;
+		}
+		if (devfs_make_node(makedev(blk_bmajor, 0), DEVFS_BLOCK, UID_ROOT,
+		    GID_OPERATOR, 0600, "rvblk0") == NULL ||
+		    devfs_make_node(makedev(blk_cmajor, 0), DEVFS_CHAR, UID_ROOT,
+		    GID_OPERATOR, 0600, "rrvblk0") == NULL) {
+			printf("virtio-blk: devfs_make_node failed\n");
+			return;
+		}
+		blk_ready = true;
+		printf("virtio-blk: /dev/rvblk0 in slot %d, %llu sectors of %u (%llu MB)\n",
+		    slot, d->capacity, VIRTIO_BLK_SECTOR,
+		    d->capacity * VIRTIO_BLK_SECTOR / (1024 * 1024));
+		return;
+	}
+	printf("virtio-blk: no block device on the bus\n");
 }
