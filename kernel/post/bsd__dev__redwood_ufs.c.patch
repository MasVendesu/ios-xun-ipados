diff --git a/bsd/dev/redwood_ufs.c b/bsd/dev/redwood_ufs.c
--- a/bsd/dev/redwood_ufs.c
+++ b/bsd/dev/redwood_ufs.c
@@ -145,6 +145,7 @@
 static volatile struct loader_block *ufs_page;
 static uint8_t *ufs_buffer;             /* the loader's data buffer: filled by it for a read, here for a write */
 static uint32_t ufs_buffer_size, ufs_parts, ufs_seq;
+static volatile bool ufs_closing;      /* the run is ending: nothing more is asked of the loader */
 static uint32_t ufs_bsize[BLOCK_MAX_PARTS];   /* the block size each device is counted in (spec_open sets 512) */
 static int ufs_bmajor = -1, ufs_cmajor = -1;
 static bool ufs_ready, ufs_dead;
@@ -304,7 +305,7 @@
 	uint32_t seq = ++ufs_seq;
 	int64_t status;
 
-	if (ufs_dead) {
+	if (ufs_dead || ufs_closing) {
 		return EIO;
 	}
 	if (op == BLOCK_OP_READ) {
@@ -1617,3 +1618,25 @@
 		}
 	}
 }
+
+/*
+ * The run is ending (loader_return, before the other processors are stopped): nothing more is asked
+ * of the loader, and a request it has not answered yet is waited for (2 s at most), so that the loader
+ * is never in the middle of a read of the storage while this kernel takes the processors and the
+ * interrupt controller away -- which, with the system volume read from the storage (DSU=2), it was.
+ */
+void
+redwood_ufs_close(void)
+{
+	uint64_t deadline;
+
+	if (ufs_page == NULL) {
+		return;
+	}
+	ufs_closing = true;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+	while (ufs_page->answer.answered != ufs_page->ask.request && mach_absolute_time() < deadline) {
+		__builtin_arm_yield();
+	}
+}
