+/*
+ * dada: the surface shown by the display controller from a buffer of its own, if it can be: 32 bits a pixel, one
+ * plane, of the display's whole size. False: it is drawn onto the panel as before.
+ */
+bool
+IOMobileFramebuffer::scanout(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	uint32_t bytes = s->info.bytesPerRow * s->info.height;
+	uint64_t began = mach_absolute_time(), nanos;
+	uint8_t * buffer;
+
+	(void) src;
+	(void) dst;
+	if (s->info.bytesPerElement != 4 || s->info.planeCount != 0 || s->info.width != fWidth || s->info.height != fHeight ||
+	    (buffer = hakios_dada_scanout_buffer(bytes)) == NULL) {
+		return false;
+	}
+	/*
+	 * What the GPU drew is in memory and not in this processor's cache, which may still hold lines of the surface
+	 * from before -- the zeros it was made with, or the last frame copied out of it -- and a copy would read those:
+	 * black or stale blocks that come and go as the lines do. Out of the cache first (clean and invalidate).
+	 */
+	for (uintptr_t line = (uintptr_t) s->pixels() & ~(uintptr_t) 63; line < (uintptr_t) s->pixels() + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	memcpy(buffer, s->pixels(), bytes);
+	fScanCopying += mach_absolute_time() - began;
+	if (!hakios_dada_scanout_show(s->info.bytesPerRow, s->info.width, s->info.height)) {
+		return false;
+	}
+	if (++fScanShown % 600 == 1) {
+		absolutetime_to_nanoseconds(fScanCopying, &nanos);
+		IOLog("MiniIOMobileFramebuffer: %u frames shown from the display's buffers, %llu us a copy (surface %u, %u bytes a "
+		    "row)\n", fScanShown, nanos / fScanShown / NSEC_PER_USEC, s->sid, s->info.bytesPerRow);
+	}
+	return true;
+}
