+/*
+ * With two rings: every one of `fences` (0s left out) done, in `milliseconds` together -- as gpuWait, of which this is
+ * one call a fence, each with what is left of the time.
+ */
+static bool
+gpuWaitList(const uint32_t * fences, unsigned count, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), ns, used;
+
+	for (unsigned i = 0; i < count; i++) {
+		if (fences[i] == 0) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		used = ns / NSEC_PER_MSEC;
+		if (!gpuWait(fences[i], used < milliseconds ? milliseconds - used : 0)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* All the GPU has been given: its last submission, or with two rings each ring's last. With the lock held. */
+static bool
+gpuWaitAll(uint64_t milliseconds)
+{
+	if (dada_gpu_rings()) {
+		uint32_t lasts[2] = { dada_gpu_last_on(0), dada_gpu_last_on(1) };
+
+		return gpuWaitList(lasts, 2, milliseconds);
+	}
+	return gpuWait(redwood_gpu_last(), milliseconds);
+}
