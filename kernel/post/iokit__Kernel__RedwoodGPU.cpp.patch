+/*
+ * dada: the pipeline-cache export (NativeMetal's CacheExport.h, UniXNU's int-147): the render server's plugin sends its shader-cache
+ * directory, as one stream in pieces, through the user-client "tunnel" -- a structure starting {0x4e544e4c, method}, any selector --
+ * with method 0x7100 and {generation, total, offset, length} before each piece. The pieces go into one piece of physical memory
+ * (boot-arg gpu_export_mb=N, none without it), which once whole is handed to the loader as the screen recording is (loader_recording;
+ * not when rec_secs records the screen): the host fetches it after the run ("oem recording", tools/dada-run.sh) and bakes it into the
+ * next image (~/hakios-gpu2/tools/m2vpack.py), whose plugin imports it before the device opens -- every boot otherwise compiled the
+ * whole UI's pipelines again on the render thread (g2k25: 138 in backboardd, 5.5 s).
+ */
+extern "C" uint64_t loader_recording[3];        /* { physical address, bytes, kernel address }: osfmk/arm64/loader_return.c */
+extern "C" void dada_gpu_worked_by(char *out, size_t size);     /* bsd/dev/hakios_dada_gpu.c: the GPU's time by process */
+static struct {
+	IOBufferMemoryDescriptor *      memory;
+	uint8_t *                       base;
+	uint64_t                        size, physical, received;
+	uint32_t                        generation, total;
+	bool                            whole;
+} gExport;
+
+#define kTunnelMagic            0x4e544e4cu
+#define kTunnelProbe            0xffffffffu
+#define kTunnelExport           0x7100u
+
+static IOReturn
+tunnel(const uint32_t * words, size_t size)
+{
+	uint32_t generation, total, offset, length;
+
+	if (words[1] == kTunnelProbe) {
+		static bool said;
+
+		if (!said) {
+			said = true;
+			IOLog("RedwoodGPU: the tunnel probed by pid %d (the pipeline-cache export: %llu MB of memory)\n", proc_selfpid(),
+			    gExport.size >> 20);
+		}
+		return kIOReturnSuccess;
+	}
+	if (words[1] != kTunnelExport || size < 24) {
+		return kIOReturnUnsupported;
+	}
+	generation = words[2];
+	total = words[3];
+	offset = words[4];
+	length = words[5];
+	if (gExport.base == NULL || 24 + (size_t) length > size || (uint64_t) total > gExport.size ||
+	    (uint64_t) offset + length > total) {
+		static uint32_t said;
+
+		if (said++ < 4) {
+			IOLog("RedwoodGPU: a pipeline-cache export piece refused (%s; %u bytes at %u of %u)\n",
+			    gExport.base == NULL ? "no export memory: boot-arg gpu_export_mb" : "out of bounds", length, offset, total);
+		}
+		return kIOReturnNoSpace;
+	}
+	IOLockLock(gGPULock);
+	if (generation != gExport.generation || total != gExport.total) {
+		IOLog("RedwoodGPU: pipeline-cache export %u begins: %u bytes\n", generation, total);
+		gExport.generation = generation;
+		gExport.total = total;
+		gExport.received = 0;
+	}
+	memcpy(gExport.base + offset, words + 6, length);
+	gExport.received += length;
+	if (offset + length == total && gExport.received >= total) {
+		uint32_t recording = 0;
+
+		gExport.whole = true;
+		if (!PE_parse_boot_argn("rec_secs", &recording, sizeof(recording)) || recording == 0) {
+			loader_recording[0] = gExport.physical;
+			loader_recording[1] = total;
+			loader_recording[2] = (uint64_t) (uintptr_t) gExport.base;
+		}
+		IOLog("RedwoodGPU: pipeline-cache export %u whole: %u bytes, for the loader\n", generation, total);
+	}
+	IOLockUnlock(gGPULock);
+	return kIOReturnSuccess;
+}
