diff --git a/bsd/dev/redwood_buttons.c b/bsd/dev/redwood_buttons.c
--- a/bsd/dev/redwood_buttons.c
+++ b/bsd/dev/redwood_buttons.c
@@ -93,22 +93,30 @@
 
 /* ---- the PMIC arbiter ---------------------------------------------------------------------------- */
 
-#define ARB_CORE_PHYS           0x0c440000UL    /* "core": the version, and which peripheral each channel is */
-#define ARB_CORE_SIZE           0x1100UL
-#define ARB_CNFG_PHYS           0x0c40a000UL    /* "cnfg": which system owns each channel */
+/*
+ * The Xiaomi 15 (dada, SM8750) as well, with boot-arg dadabuttons=1: the same three keys on the same
+ * peripherals (its PMK8550's PON at 0x1300 of slave 0, GPIO6 of its PM8550 at 0x8d00 of slave 1: dt
+ * pon_hlos@1300, gpio_keys vol_up), behind a version 7 arbiter (qcom,spmi@c42d000: core 0xc400000,
+ * cnfg 0xc42d000, obsrvr 0xc440000), whose channel map is at 0x2000 of "core" and whose observer
+ * channels are 0x20 apart, 0x8000 per system (Linux: pmic_arb_v7).
+ */
+static bool dada;
+#define ARB_CORE_PHYS           (dada ? 0x0c400000UL : 0x0c440000UL)    /* "core": the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           (dada ? 0x3000UL : 0x1100UL)
+#define ARB_CNFG_PHYS           (dada ? 0x0c42d000UL : 0x0c40a000UL)    /* "cnfg": which system owns each channel */
 #define ARB_CNFG_SIZE           0x1000UL
-#define ARB_OBSERVER_PHYS       0x0e600000UL    /* "obsrvr": 0x10000 per system, 0x80 per channel in it */
-#define ARB_OBSERVER_SIZE       0x10000UL       /* ours is the first */
+#define ARB_OBSERVER_PHYS       (dada ? 0x0c440000UL : 0x0e600000UL)    /* "obsrvr": 0x10000 per system, 0x80 per channel in it */
+#define ARB_OBSERVER_SIZE       (dada ? 0x8000UL : 0x10000UL)           /* ours is the first */
 #define ARB_SYSTEM              0               /* who we are to the arbiter: the device tree's "qcom,ee" */
 
 #define ARB_VERSION             0x000
 #define ARB_VERSION_5           0x50000000u     /* what follows is version 5's; 7 moved things again */
 #define ARB_VERSION_7           0x70000000u
 #define ARB_FEATURES            0x004           /* [10:0] the number of channels */
-#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* core: [19:8] slave and peripheral, [24] interrupts go to the owner */
+#define ARB_CHANNEL(n)          ((dada ? 0x2000 : 0x900) + 4 * (n))     /* core: [19:8] slave and peripheral, [24] interrupts go to the owner */
 #define ARB_CHANNEL_INTERRUPTS  (1u << 24)
 #define ARB_OWNER(n)            (0x700 + 4 * (n))       /* cnfg: [2:0] the system that may write through channel n */
-#define ARB_MAX_CHANNELS        512
+#define ARB_MAX_CHANNELS        (dada ? 1024 : 512)
 
 #define OBSERVER_COMMAND        0x00
 #define OBSERVER_STATUS         0x08
@@ -164,7 +172,8 @@
 static const char *
 spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
 {
-	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	vm_offset_t channel = dada ? arb_observer + 0x8000UL * ARB_SYSTEM + 0x20UL * p->channel :
+	    arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
 	uint64_t start = mach_absolute_time(), now, interval, taken;
 	uint32_t status, data[2];
 	const char *problem = NULL;
@@ -461,7 +470,7 @@
 	version = rd(arb_core + ARB_VERSION);
 	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
 	printf("buttons: PMIC arbiter version %#x, %u channels\n", version, channels);
-	if (version < ARB_VERSION_5 || version >= ARB_VERSION_7) {
+	if (version < ARB_VERSION_5 || (version >= ARB_VERSION_7 && !dada) || (dada && version < ARB_VERSION_7)) {
 		printf("buttons: this driver knows version 5 of the arbiter only: no buttons\n");
 		goto out;
 	}
@@ -546,6 +555,14 @@
 
 		enabled = PE_parse_boot_argn("touchscreen", &touch_screen, sizeof(touch_screen)) && touch_screen != 0;
 	}
+	{
+		uint32_t on = 0;
+
+		if (PE_parse_boot_argn("dadabuttons", &on, sizeof(on)) && on != 0) {
+			dada = true;
+			enabled = 1;
+		}
+	}
 	if (!enabled) {
 		return;
 	}
