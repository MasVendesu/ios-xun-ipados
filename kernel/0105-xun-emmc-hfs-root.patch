+/*
+ * mockfs_check_macho: 0 when the first block of rvp carries a Mach-O magic (thin or fat),
+ * EFTYPE when it does not, or the error of the read.
+ */
+static int
+mockfs_check_macho(vnode_t rvp)
+{
+	buf_t bp = NULL;
+	uint32_t magic = 0;
+	int error;
+
+	error = (int)buf_meta_bread(rvp, 0, DEV_BSIZE, NOCRED, &bp);
+	if (error) {
+		return error;
+	}
+	memcpy(&magic, (const void *)buf_dataptr(bp), sizeof(magic));
+	buf_brelse(bp);
+
+	switch (magic) {
+	case MH_MAGIC:
+	case MH_CIGAM:
+	case MH_MAGIC_64:
+	case MH_CIGAM_64:
+	case FAT_MAGIC:
+	case FAT_CIGAM:
+		return 0;
+	default:
+		return EFTYPE;
+	}
+}
