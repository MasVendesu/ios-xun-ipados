  *            in this value will automatically be incremented for each PTE
  *            write.
  */
+static inline void
+arm64_quad_pte_write(pt_entry_t *ptep, pt_entry_t pte0, pt_entry_t pte1, pt_entry_t pte2, pt_entry_t pte3)
+{
+	__asm__ volatile (
+		"stp %0, %1, [%4]\n"
+		"stp %2, %3, [%4, #16]\n"
+		"dc civac, %4\n"
+		"dsb sy\n"
+		"isb\n"
+		:
+		: "r"(pte0), "r"(pte1), "r"(pte2), "r"(pte3), "r"(ptep)
+		: "memory"
+	);
+}
+
+static inline void
+pmap_quad_tlb_invalidate(pmap_t pmap, vm_offset_t va)
+{
+	uint32_t asid = (pmap != NULL) ? pmap->hw_asid : 0;
+	uint64_t v_base = ((uint64_t)asid << 48) | ((va >> 12) & 0x00000FFFFFFFFFFFULL);
+	uint64_t v0 = v_base;
+	uint64_t v1 = v_base + 1ULL;
+	uint64_t v2 = v_base + 2ULL;
+	uint64_t v3 = v_base + 3ULL;
+
+	__asm__ volatile (
+		"dsb ishst\n"
+		"tlbi vale1is, %0\n"
+		"tlbi vale1is, %1\n"
+		"tlbi vale1is, %2\n"
+		"tlbi vale1is, %3\n"
+		"dsb ish\n"
+		"isb\n"
+		:
+		: "r"(v0), "r"(v1), "r"(v2), "r"(v3)
+		: "memory"
+	);
+}
