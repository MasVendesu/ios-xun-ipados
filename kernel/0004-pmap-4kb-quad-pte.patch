+/*
+ * Translation Granule: Snapdragon 685 SM6225 Cortex-A73/A53 baseline has TGran16 == 0.
+ * The hardware MMU uses 4KB translation granules (ARM_PGSHIFT = 12), while the Mach VM
+ * uses 16KB virtual pages (PAGE_SHIFT = 14) via Quad-PTE emulation (PAGE_RATIO = 4).
+ */
+#undef __ARM_16K_PG__
+#define ARM_PGSHIFT               12
+#define ARM_PGBYTES               (1 << ARM_PGSHIFT)
+#define ARM_PGMASK                (ARM_PGBYTES - 1)
